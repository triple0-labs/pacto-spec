# git-guardrails runtime configuration
# STRICT_MODE=1 blocks on failed checks. Set to 0 for warn-only behavior.
STRICT_MODE=1

# Optional explicit remote override. Empty means: upstream remote, then origin.
REMOTE_OVERRIDE=

# Optional GitHub PR diagnostics via gh CLI. Missing/unauthed gh never blocks.
ENABLE_GH_DIAGNOSTICS=1

# Optional explicit repo for gh checks, e.g. owner/repo
GH_REPO=
